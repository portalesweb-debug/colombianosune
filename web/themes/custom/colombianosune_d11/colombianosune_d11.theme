<?php

/**
 * @file
 * Functions to support theming in the colombianosune_d11 theme.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function colombianosune_d11_preprocess_html(&$variables) {
  // Agregar clases personalizadas al body
  $variables['attributes']['class'][] = 'colombianos-une-theme';

  // Agregar meta tags personalizados
  $viewport = [
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'viewport',
      'content' => 'width=device-width, initial-scale=1, shrink-to-fit=no',
    ],
  ];
  $variables['page']['#attached']['html_head'][] = [$viewport, 'viewport'];
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 */
function colombianosune_d11_preprocess_page(&$variables) {
  // Agregar variables personalizadas para la página
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
  $variables['site_slogan'] = \Drupal::config('system.site')->get('slogan');
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function colombianosune_d11_preprocess_node(&$variables) {
  // Agregar clases personalizadas a los nodos
  $node = $variables['node'];
  $variables['attributes']['class'][] = 'node--' . $node->bundle();

  // Formatear fecha de publicación
  if (!empty($variables['date'])) {
    $variables['date'] = \Drupal::service('date.formatter')->format($node->getCreatedTime(), 'custom', 'd/m/Y');
  }
}

/**
 * Implements hook_preprocess_HOOK() for block.html.twig.
 */
function colombianosune_d11_preprocess_block(&$variables) {
  // Agregar clases Bootstrap a bloques específicos
  if (isset($variables['plugin_id'])) {
    $variables['attributes']['class'][] = 'block--' . str_replace('_', '-', $variables['plugin_id']);
  }
}

/**
 * Implements hook_form_alter().
 */
function colombianosune_d11_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Agregar clases Bootstrap a formularios
  switch ($form_id) {
    case 'search_block_form':
      $form['keys']['#attributes']['class'][] = 'form-control';
      $form['keys']['#attributes']['placeholder'] = t('Buscar...');
      $form['actions']['submit']['#attributes']['class'][] = 'btn btn-primary';
      break;

    case 'user_login_form':
      $form['name']['#attributes']['class'][] = 'form-control';
      $form['pass']['#attributes']['class'][] = 'form-control';
      $form['actions']['submit']['#attributes']['class'][] = 'btn btn-primary';
      break;
  }
}

/**
 * Implements hook_theme_suggestions_HOOK_alter() for form templates.
 */
function colombianosune_d11_theme_suggestions_form_alter(array &$suggestions, array $variables) {
  if (isset($variables['element']['#form_id'])) {
    $suggestions[] = 'form__' . str_replace('-', '_', $variables['element']['#form_id']);
  }
}

/**
 * Implements hook_preprocess_HOOK() for menu.html.twig.
 */
function colombianosune_d11_preprocess_menu(&$variables) {
  // Agregar clases Bootstrap al menú principal
  if (isset($variables['menu_name']) && $variables['menu_name'] == 'main') {
    foreach ($variables['items'] as &$item) {
      $item['attributes']->addClass('nav-item');
      $item['url']->setOption('attributes', ['class' => ['nav-link']]);
    }
  }
}

/**
 * Implements hook_preprocess_HOOK() for field.html.twig.
 */
function colombianosune_d11_preprocess_field(&$variables) {
  $field_name = $variables['field_name'];
  $field_type = $variables['field_type'];

  // Agregar clases específicas según el tipo de campo
  switch ($field_type) {
    case 'image':
      $variables['attributes']['class'][] = 'field--image-responsive';
      break;

    case 'text_long':
    case 'text_with_summary':
      $variables['attributes']['class'][] = 'field--text-content';
      break;
  }
}
