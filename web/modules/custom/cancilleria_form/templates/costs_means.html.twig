{#
/**
 * @file costs_means.html.twig
 * Default theme implementation to present Costs means data.
 *
 * This template is used when viewing Costs means pages.
 *
 *
 * Available variables:
 * - content: A list of content items. Use 'content' to print all content, or
 * - attributes: HTML attributes for the container element.
 *
 * @see template_preprocess_costs_means()
 *
 * @ingroup themeable
 */
#}
<div{{ attributes.addClass('costs_means') }}>
  {% if content %}
    {{- content -}}
  {% endif %}
</div>
